
;; Clock @ 7.25us per cycle
.program dcc
.side_set 1 opt

;.define public PreambleCount 13             ; zero based, will be 14 1 bits

.wrap_target
start:
    ; Take the first word of the packet from the FIFO.
    ;
    ; This was `pull block`. A blocking pull parks the state machine with the pin
    ; holding whatever level the last side_set left -- which is not "the signal
    ; stops", it is one polarity held for as long as the FIFO stays empty. An
    ; H-bridge driven from that pin puts DC on the rails, and a decoder that loses
    ; the alternating waveform falls back to DC mode, which means full speed (#34).
    ;
    ; `pull noblock` instead copies X into the OSR when the FIFO is empty, so a
    ; starved state machine falls through to `starved` below and keeps emitting
    ; legal '1' bits until real data arrives. The signal degrades to an idle
    ; carrier rather than to DC.
    pull noblock

    ; First byte is number of Preamble bits that should be sent (allows same code for main and prog)
    out y, 8                                ; setup preamble bit count

    ; Second byte is number of bytes in packet (inc. Error byte that is pre calculated in CPU)
    ; Shift first byte from OSR in to ISR to use as a byte counter
    ; This is done before the preamble to ensure correct timing to first packet bit
    out x, 8

    ; Starvation test, costing no sentinel register of its own.
    ;
    ; On an empty FIFO `pull noblock` loaded X, so both of the OUTs above read
    ; from the same byte of it and X == Y. A real packet can never do that: Y is
    ; the preamble count (14 main, 20 prog) and X is the byte count, which is at
    ; most six for any DCC packet this station builds. dcc_program_init() seeds
    ; X and Y equal so the very first pass on an empty FIFO idles rather than
    ; transmitting whatever the scratch registers powered up holding.
    jmp x!=y have_packet

starved:
    ; No data. Emit one legal '1' bit and go round again.
    ;
    ; Cycle budget -- every '1' half must be 8 cycles (58us), and the header above
    ; runs at the carried-low level, so it counts toward the low half:
    ;   gap -> packet   3 (gap) + 5 (pull,out,out,jmp taken,jmp x--)      = 8
    ;   gap -> starved  3 (gap) + 4 (pull,out,out,jmp not taken) + 1 (pad) = 8
    ;   starved -> starved  3 (jmp) + 4 + 1                               = 8
    ;   starved -> packet   3 (jmp) + 5                                   = 8
    nop                     side 0          ; 1 cycle: pads the starved path to
                                            ; match the two extra header cycles
                                            ; the packet path spends
    nop                     side 1  [7]     ; 8 cycles = 58us high
    jmp start               side 0  [2]     ; 3 cycles low; the header adds the rest

have_packet:
    jmp x-- preamble_bits                   ; Need to decrement for the post decrement at the end of the loop other wise we will loop 1 too many times

    ; Send preamble
preamble_bits:
    nop                     side 1  [7]     ; set output high and wait for high half cycle
    jmp y-- preamble_bits   side 0  [7]     ; set output low and wait for low half cycle
    
    nop                     side 1  [2]     ; on entry from the preamble nothing precedes us, whereas re-entry
                                            ; from byte_end arrives with 3 cycles already high
                                            ; (jmp y--, mov x, isr, jmp x--). 3 cycles matches them.

send_byte:

    ; Send packet
    ; Send start bit
    nop                     side 1  [4]     ; have to have extra nops as delay is limited to 3 bits because we are using optional side_set which takes 2 of the 5 delay bits
    nop                     side 1  [7]     ; 1 of the cycles is either from before send_byte or the byte_end jmp
    nop                     side 0  [7]     ; Last bit of delay is on the next pull instruction

    ; pull next FIFO word ifEmpty
    pull ifempty            side 0  [5]     ; if we have run out of bits in the OSR pull in the next word from the FIFO

    ; keep byte count in isr as need both x and y for local counters
    mov isr, x

    ; setup bit counter
    set y, 7

    nop                     side 1
byte_bits:
    out x, 1                side 1  [5]
    jmp !x byte_zero_high
    jmp byte_end            side 0  [7]
byte_zero_high:
    nop                     side 1  [7]
    nop                     side 0  [7]
    nop                     side 0  [7]
byte_end:
    jmp y-- byte_bits       side 1

    ; Decrement packet count in ISR
    mov x, isr                              ; restore byte counter from isr into x for byte decrement
    jmp x-- send_byte

final_bit:
    ; Send '1' bit
    nop                     side 1  [4]     ; set output high and wait for high half cycle
                                            ; (three cycles already arrived: the byte_end jmp,
                                            ;  mov x, isr and jmp x-- all hold the line high)
    nop                     side 0  [7]     ; set output low and wait for low half cycle

    ; Inter-packet gap, as one legal '1' bit rather than a held level.
    ;
    ; This was two `side 1` delays -- 116us of high with no low half, running
    ; straight into the next packet's first preamble instruction (another 58us
    ; high) and the four cycles of pull/out/out/jmp below, which carry the
    ; previous level because side_set is `opt`. The line was continuously high
    ; for 203us and then dropped for 58us: mismatched halves, so not a bit at
    ; all. A decoder resynchronised and consumed the first preamble bit, leaving
    ; exactly the S-9.1 minimum of 14 with nothing spare, and an H-bridge driven
    ; from the pin put 203us of DC on the rails at every packet boundary (#34).
    ;
    ; The comment that justified it -- "to continue powering" -- had it
    ; backwards: DCC track power comes from the alternating waveform, and
    ; holding one polarity adds nothing while giving the booster's DC-detect
    ; something to object to.
    ;
    ; The low half is deliberately split across the wrap. Three cycles here plus
    ; the five of pull/out/out/jmp/jmp make 58us, so the overhead lands *inside*
    ; the half instead of extending it, and the gap costs no extra instructions.
    ; (It was four plus four before the starvation branch added an instruction to
    ; the packet path -- see the cycle budget at `starved`.)
    nop                     side 1  [7]     ; 8 cycles = 58us high
    nop                     side 0  [2]     ; 3 cycles; + 5 below = 58us low

.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void dcc_program_init(PIO pio, uint sm, uint offset, uint pin, uint preamble) {

    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);

    pio_sm_config c = dcc_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_out_shift(&c, false, false, 32);          // LSB first, no autopull
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);

    float div = clock_get_hz(clk_sys) / (8620.68966 * 16);   // This is frequency (8620.68966) in Hz for a 116uS square wave, times by 16 instructions per full wave cycle
    sm_config_set_clkdiv(&c, div);

    pio_sm_init(pio, sm, offset, &c);

    // Seed X and Y equal. The starvation test at `start` reads "X == Y" as "the
    // FIFO was empty", and until the first packet completes, the scratch
    // registers hold whatever they powered up with. Without this, a state
    // machine enabled before anything is queued could read two unequal bytes out
    // of an uninitialised X and transmit them as a packet header (#34).
    pio_sm_exec(pio, sm, pio_encode_set(pio_x, 0));
    pio_sm_exec(pio, sm, pio_encode_set(pio_y, 0));
}
%}

.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
build

# Coverage files (generated)
*.gcov
*.gcda
*.gcno
lcov.info
coverage/

# Stray in-source CMake artifacts (build/host and build/pico are the only trees)
/CMakeFiles/
/CMakeCache.txt

# Machine-local preset overrides (toolchain paths, PATH fixes). CMakePresets.json
# is committed and portable; anything specific to one machine belongs here.
CMakeUserPresets.json

# Claude Code local state (agents, skills and settings.json ARE committed)
.claude/settings.local.json
.claude/worktrees/

# KiCad per-user and generated files. hardware/fab/rev-X.Y/ is the record of what
# went to fab; a fresh plot lands in hardware/Gerber/ and must not be mistaken for it.
hardware/Gerber/
hardware/*-backups/
hardware/fp-info-cache
hardware/*.kicad_prl
hardware/~*.lck
hardware/*.bak
hardware/PicoDCC.csv
